# ------------------------------------------------------------
# LiteLLM Routing
# ------------------------------------------------------------

# Per-model LiteLLM routing configuration (default: OpenCode Go; set null to use LiteLLM defaults)
# Type: RoutingConfig (object)
# Default: OpenCode Go default provider
#
# routing_config:
#   # OpenCode Go is the default: every model without its own mapping is routed there
#   # (api_key comes from $OPENCODE_API_KEY). Set routing_config: null for LiteLLM defaults.
#   default:
#     api_base: "https://opencode.ai/inference/go/openai/v1"
#     api_key: "${OPENCODE_API_KEY}"
#     headers: {}
#   providers:
#     my-proxy:
#       api_base: "https://proxy.example.com/v1"
#       api_key: "${PROXY_API_KEY}"
#       headers:
#         authorization: "${PROXY_TOKEN}"
#   models:
#     anthropic/claude-sonnet-4-5-20250929: my-proxy

